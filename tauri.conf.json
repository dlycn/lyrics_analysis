{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.abc.lyrics",
  "productName": "abclyrics",
  "mainBinaryName": "abclyricsbin",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "dist",
    "windows": {
      "staticVCRuntime": true
    }
  },
  
  "bundle": {
    "resources": {}
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "abclyrics studio",
        "width": 1280,
        "height": 960,
        "minWidth": 960,
        "minHeight": 720
      }
    
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "assets/soundfonts/**/*"
          ]
        }
      },
      "capabilities": [
        "default"
      ],
      "freezePrototype": false,
      "pattern": {
        "use": "brownfield"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": {
        "default-src": "'self' asset: http://asset.localhost",
        "connect-src": "'self' http://*.localhost https://* sf: http://sf.localhost",
        "img-src": "'self' blob: data: asset: http://asset.localhost",
        "media-src": "'self' blob: data: asset: http://asset.localhost",
        "style-src": "'unsafe-inline' 'self'",
        "script-src": "'wasm-unsafe-eval' 'self'"
      }
    }
  }
}
