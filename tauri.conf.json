{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.abc.lyrics",
  "productName": "abclyrics",
  "mainBinaryName": "abclyricsbin",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "dist",
    "windows": {
      "staticVCRuntime": true
    }
  },
  
  "bundle": {
    "resources": {
      "assets/lyrics/": "lyrics",
      "assets/soundfonts/": "soundfonts",
      "assets/test/": "test"
    }
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "abclyrics studio",
        "width": 1280,
        "height": 960,
        "minWidth": 960,
        "minHeight": 720
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "",
        "width": 320,
        "height": 64,
        "x": 40,
        "y": 40,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "fullscreen": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$RESOURCE/**/*"
          ]
        }
      },
      "capabilities": [
        "default"
      ],
      "freezePrototype": false,
      "pattern": {
        "use": "brownfield"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": {
        "default-src": "'self' blob: data: asset: http://asset.localhost",
        "connect-src": "'self' http://*.localhost",
        "img-src": "'self' http://asset.localhost https://*.jsdelivr.net https://*.npmmirror.com",
        "media-src": "'self' http://asset.localhost",
        "style-src": "'unsafe-inline' 'self'",
        "script-src": "'wasm-unsafe-eval' 'self'"
      }
    }
  }
}